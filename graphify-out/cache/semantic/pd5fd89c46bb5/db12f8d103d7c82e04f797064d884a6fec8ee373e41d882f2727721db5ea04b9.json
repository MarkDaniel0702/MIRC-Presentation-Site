{"nodes": [{"id": "prototype_readme", "label": "Conference website prototype README", "file_type": "document", "source_file": "prototype/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prototype_readme_multi_conference_model", "label": "One site, many conferences, many years", "file_type": "rationale", "source_file": "prototype/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No conference name or year is written into code: per-conference defaults live in conferences.js, per-year data in an edition record, screens ask P.tag()/P.series().code, so a new year or conference needs no code change."}, {"id": "prototype_readme_edition", "label": "Edition (conference year)", "file_type": "concept", "source_file": "prototype/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prototype_readme_edition_record", "label": "Edition record (MIRC_2026, EDITIONS)", "file_type": "concept", "source_file": "prototype/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prototype_readme_edition_switch", "label": "Edition switch (ED, S, P.useEdition)", "file_type": "concept", "source_file": "prototype/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prototype_readme_yearly_rollover", "label": "Yearly edition rollover (P.newEdition)", "file_type": "concept", "source_file": "prototype/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Copies set-up (pages, rooms, topics, templates, settings) but never papers, people, schedule or news; resets dates so each year starts clean."}, {"id": "prototype_readme_draft_published_visibility", "label": "Draft vs published visibility", "file_type": "concept", "source_file": "prototype/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prototype_readme_viewing_as", "label": "Viewing as (role simulation)", "file_type": "concept", "source_file": "prototype/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stands in for real sign-in, which needs an authentication service the prototype does not have."}, {"id": "prototype_readme_my_conferences", "label": "My conferences (on-screen conference builder)", "file_type": "concept", "source_file": "prototype/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prototype_readme_customconferences_storage", "label": "customConferences localStorage", "file_type": "concept", "source_file": "prototype/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No server, so browser storage meets 'not lost on reload'; only the definition is saved, damaged entries are skipped one by one so a bad entry cannot stop the site opening."}, {"id": "prototype_readme_pantas", "label": "PANTAS conference (placeholder)", "file_type": "concept", "source_file": "prototype/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prototype_readme_logo_management", "label": "Logo management", "file_type": "concept", "source_file": "prototype/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prototype_readme_logo_specification", "label": "Logo upload specification", "file_type": "rationale", "source_file": "prototype/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Minimum 240 px = 2x the 120 px header frame for high-res screens; 600x600 recommended to stay sharp at Largest on the home page; rounded square frame holds square, round and wide logos; type checked by first bytes, SVG only shown via img so it cannot run code."}, {"id": "prototype_readme_site_colors", "label": "Visitor-site colors (8-color palette)", "file_type": "concept", "source_file": "prototype/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Palette written as --t-* variables on the .site wrapper and re-pointed in styles.css so every component follows it with no colors in components; admin area stays outside .site and keeps its own colors."}, {"id": "prototype_readme_wcag_contrast_checks", "label": "WCAG readability checks", "file_type": "concept", "source_file": "prototype/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prototype_readme_draft_publish_pattern", "label": "Save as draft / Publish now pattern", "file_type": "rationale", "source_file": "prototype/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On a published edition visitors keep the old logo/colors while Webmaster and Administrator preview the draft, which can then be published or discarded."}, {"id": "prototype_readme_administrator_only_publishing", "label": "Administrator-only publishing (production rule)", "file_type": "concept", "source_file": "prototype/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prototype_readme_my_account_button", "label": "My Account button", "file_type": "concept", "source_file": "prototype/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaced 'My Space (Participant)': covers registration, submissions, account details and sign-out; 'Participant Portal/Dashboard' rejected because reviewers and organizers use it too; role moved into the menu's first line."}, {"id": "prototype_readme_older_adult_design", "label": "Design for older administrators", "file_type": "rationale", "source_file": "prototype/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Most administrators are older adults: large relative-sized text, plain words, big targets, confirmation with safe default, words plus symbols never color alone, persistent messages, keyboard focus ring."}, {"id": "prototype_readme_calendar_picker", "label": "Calendar date picker and 24-hour time boxes", "file_type": "concept", "source_file": "prototype/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prototype_readme_classic_scripts", "label": "Classic scripts, not ES modules", "file_type": "rationale", "source_file": "prototype/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Browsers block modules when a page is opened straight from a folder (file://), so plain scripts loaded in a fixed order are used."}, {"id": "prototype_readme_no_build_stack", "label": "Plain HTML/CSS/JS with no build step", "file_type": "rationale", "source_file": "prototype/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Blueprint's Next.js, Tailwind and Supabase need a build and a server, making the prototype harder to open and test; styles.css tokens reuse the blueprint's Tailwind token names so they carry over."}, {"id": "prototype_readme_admin_area", "label": "Administration area (#/admin)", "file_type": "concept", "source_file": "prototype/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prototype_readme_public_site_preview", "label": "Public website preview (#/site)", "file_type": "concept", "source_file": "prototype/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prototype_readme_blueprint_coverage", "label": "Blueprint-to-prototype coverage", "file_type": "concept", "source_file": "prototype/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prototype_readme_simulated_vs_real", "label": "Simulated and real table", "file_type": "concept", "source_file": "prototype/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prototype_readme_open_decisions", "label": "Open blueprint decisions (D5 fees, D12 review rules, ...)", "file_type": "concept", "source_file": "prototype/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prototype_readme_production_needs", "label": "Production requirements (database, auth, storage, email)", "file_type": "concept", "source_file": "prototype/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prototype_readme_automated_tests", "label": "Automated Playwright test suite", "file_type": "concept", "source_file": "prototype/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "graphify_out_converted_mirc_prototype_flow_guide_aecdca47_mirc", "target": "prototype_conferences", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "prototype/README.md", "source_location": null, "weight": 1.0}, {"source": "prototype_readme", "target": "mirc2026_website_blueprint", "relation": "cites", "con