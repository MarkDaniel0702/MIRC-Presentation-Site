  <diagram id="pg6" name="6 Program">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="pg6-title" value="&lt;b style=&quot;font-size:20px&quot;&gt;6. Administration: rooms, schedule and program display&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;Dashboard &amp;gt; Program. The checks explain problems in plain words before an event is saved.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="14" width="760" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pg6-s" value="Start: Dashboard &amp;gt; Program" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1F3D2B;strokeColor=#1F3D2B;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="610" y="120" width="250" height="46" as="geometry" />
        </mxCell>
        <mxCell id="pg6-dt" value="Which task?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#B8860B;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="600" y="224" width="270" height="98" as="geometry" />
        </mxCell>
        <mxCell id="pg6-a1" value="Open 'Rooms'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#2F6B44;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="55" y="429" width="240" height="56" as="geometry" />
        </mxCell>
        <mxCell id="pg6-a2" value="Add a room with the form, or change one with 'Change'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#2F6B44;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="55" y="579" width="240" height="56" as="geometry" />
        </mxCell>
        <mxCell id="pg6-a3" value="Delete a room?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#B8860B;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="40" y="714" width="270" height="98" as="geometry" />
        </mxCell>
        <mxCell id="pg6-a3y" value="Confirm 'Delete this room?' (a warning shows if events use it)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#2F6B44;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="335" y="735" width="240" height="56" as="geometry" />
        </mxCell>
        <mxCell id="pg6-a4" value="The room list is updated; the rooms can be chosen in the Schedule" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=18;whiteSpace=wrap;html=1;fillColor=#E3EEF9;strokeColor=#2F5597;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="55" y="884" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pg6-b1" value="Open 'Schedule' and click a day on the calendar (solid border = conference day, a number = events planned)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#2F6B44;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="615" y="414" width="240" height="86" as="geometry" />
        </mxCell>
        <mxCell id="pg6-b2" value="Click 'Add an event on this day'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#2F6B44;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="615" y="579" width="240" height="56" as="geometry" />
        </mxCell>
        <mxCell id="pg6-b3" value="Choose a type (Session, Speech/Intervention, Logistics, Break or Tour), set the times with the 24-hour boxes and pick a room" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#2F6B44;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="615" y="720" width="240" height="86" as="geometry" />
        </mxCell>
        <mxCell id="pg6-b4" value="Do the checks pass?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#B8860B;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="600" y="870" width="270" height="98" as="geometry" />
        </mxCell>
        <mxCell id="pg6-b4n" value="Problem in plain words: the end must be after the start, a room cannot be double-booked, a talk must fit inside its session" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=18;whiteSpace=wrap;html=1;fillColor=#E3EEF9;strokeColor=#2F5597;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="895" y="876" width="240" height="86" as="geometry" />
        </mxCell>
        <mxCell id="pg6-b5" value="The event is saved on that day" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#2F6B44;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="615" y="1026" width="240" height="56" as="geometry" />
        </mxCell>
        <mxCell id="pg6-b6" value="Add papers to this session as talks?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#B8860B;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="600" y="1140" width="270" height="98" as="geometry" />
        </mxCell>
        <mxCell id="pg6-b6y" value="Add each paper as a talk (it is checked for fit and overlap)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#2F6B44;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="895" y="1161" width="240" height="56" as="geometry" />
        </mxCell>
        <mxCell id="pg6-b7" value="The public program page shows the result" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=18;whiteSpace=wrap;html=1;fillColor=#E3EEF9;strokeColor=#2F5597;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="615" y="1296" width="240" height="56" as="geometry" />
        </mxCell>
        <mxCell id="pg6-c1" value="Open 'Program display'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#2F6B44;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
