        <mxCell id="pg5-title" value="&lt;b style=&quot;font-size:20px&quot;&gt;5. Administration: registered people, registration form and user accounts&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;Dashboard &amp;gt; Attendees. &amp;quot;Send confirmation&amp;quot; only records a line; passwords are never kept.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="14" width="760" height="60" as="geometry" />
