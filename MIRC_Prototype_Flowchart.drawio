  <diagram id="pg4" name="4 Papers and reviewers">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="pg4-title" value="&lt;b style=&quot;font-size:20px&quot;&gt;4. Administration: papers, decisions, reviewers and the book of abstracts&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;Dashboard &amp;gt; Papers and decisions / Reviewers. No email goes to authors; reviewer scoring is not built.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="14" width="760" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pg4-s" value="Start: Dashboard &amp;gt; Papers and decisions or Reviewers" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1F3D2B;strokeColor=#1F3D2B;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="610" y="120" width="250" height="54" as="geometry" />
        </mxCell>
        <mxCell id="pg4-dt" value="Which task?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#B8860B;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="600" y="232" width="270" height="98" as="geometry" />
        </mxCell>
        <mxCell id="pg4-a1" value="Open 'Papers received'. Filter by status, type or topic, or search by title, author or number" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#2F6B44;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="55" y="422" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pg4-a2" value="Act on one paper or on many?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#B8860B;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="40" y="550" width="270" height="98" as="geometry" />
        </mxCell>
        <mxCell id="pg4-a2m" value="Tick the papers, choose a bulk action (for example 'Set status to Refused') and press Apply" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#2F6B44;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="335" y="564" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pg4-a3" value="Click 'Open' on a paper to see its details, abstract, notes and history" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#2F6B44;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="55" y="706" width="240" height="56" as="geometry" />
        </mxCell>
        <mxCell id="pg4-a4" value="Choose Accept, Refuse or Request changes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#2F6B44;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="55" y="841" width="240" height="56" as="geometry" />
        </mxCell>
        <mxCell id="pg4-a5" value="Confirm in the window? ('No, go back' is pre-selected)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#B8860B;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="40" y="976" width="270" height="112" as="geometry" />
        </mxCell>
        <mxCell id="pg4-a5n" value="Nothing changes; the paper keeps its status" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=18;whiteSpace=wrap;html=1;fillColor=#E3EEF9;strokeColor=#2F5597;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="335" y="1004" width="240" height="56" as="geometry" />
        </mxCell>
        <mxCell id="pg4-a6" value="The status changes and a line is added to the paper's history table" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#2F6B44;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
