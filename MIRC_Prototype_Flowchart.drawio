        <mxCell id="pg8-c1" value="Open 'Files and pictures'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#2F6B44;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="1160" y="422" width="240" height="56" as="geometry" />
        </mxCell>
        <mxCell id="pg8-c2" value="File names and sizes are listed and the 200 MB limit is checked (nothing is really uploaded)" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=18;whiteSpace=wrap;html=1;fillColor=#E3EEF9;strokeColor=#2F5597;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
