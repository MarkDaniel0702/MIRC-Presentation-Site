  <diagram id="pg10" name="10 Logo and site colors">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="pg10-title" value="&lt;b style=&quot;font-size:20px&quot;&gt;10. Administration: logo and site colors&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;Conference &amp;gt; Logo and Website &amp;gt; Site colors. Both belong to one edition; a published edition can take a change at once or as a draft.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="14" width="760" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pg10-s" value="Start: Dashboard &amp;gt; Conference &amp;gt; Logo, or Website &amp;gt; Site colors" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1F3D2B;strokeColor=#1F3D2B;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="470" y="120" width="250" height="54" as="geometry" />
        </mxCell>
        <mxCell id="pg10-dt" value="Which task?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#B8860B;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="460" y="232" width="270" height="98" as="geometry" />
        </mxCell>
        <mxCell id="pg10-a1" value="Open 'Logo' and choose a picture file (the rules are shown first: PNG or SVG, up to 2 MB, at least 240 pixels)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#2F6B44;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="55" y="422" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pg10-a2" value="Does the file pass the checks?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#B8860B;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="40" y="550" width="270" height="98" as="geometry" />
        </mxCell>
        <mxCell id="pg10-a2n" value="The file is refused with a plain explanation; the logo is unchanged" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=18;whiteSpace=wrap;html=1;fillColor=#E3EEF9;strokeColor=#2F5597;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="335" y="564" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pg10-a3" value="Check the preview (header, phone header, menu bar); optionally zoom and move; choose where it appears; write a text description" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#2F6B44;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="55" y="706" width="240" height="86" as="geometry" />
        </mxCell>
        <mxCell id="pg10-a4" value="Is the text description filled in?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#B8860B;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="40" y="850" width="270" height="98" as="geometry" />
        </mxCell>
        <mxCell id="pg10-a4n" value="A message asks for a short description" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=18;whiteSpace=wrap;html=1;fillColor=#E3EEF9;strokeColor=#2F5597;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
