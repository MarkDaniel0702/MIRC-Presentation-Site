  <diagram id="pg9" name="9 Conferences and editions">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="pg9-title" value="&lt;b style=&quot;font-size:20px&quot;&gt;9. Administration: your own conferences, yearly editions and publishing&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;Dashboard &amp;gt; Conference. Publishing is simulated: it only changes what &amp;quot;Viewing as&amp;quot; can see. In production only the Administrator may publish.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="14" width="760" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pg9-s" value="Start: Dashboard &amp;gt; Conference" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1F3D2B;strokeColor=#1F3D2B;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="610" y="120" width="250" height="46" as="geometry" />
        </mxCell>
        <mxCell id="pg9-dt" value="Which task?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#B8860B;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="600" y="224" width="270" height="98" as="geometry" />
        </mxCell>
        <mxCell id="pg9-a1" value="Open 'My conferences' and click 'Create a new conference'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#2F6B44;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="55" y="414" width="240" height="56" as="geometry" />
        </mxCell>
        <mxCell id="pg9-a2" value="Fill in name, short name, first year and dates, place, theme, description and two brand colors; choose whether to publish" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#2F6B44;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="55" y="528" width="240" height="86" as="geometry" />
        </mxCell>
        <mxCell id="pg9-a3" value="Press 'Create the conference'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#2F6B44;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="55" y="700" width="240" height="56" as="geometry" />
        </mxCell>
        <mxCell id="pg9-a4" value="Do all the checks pass? (names unused, dates valid, colors readable)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#B8860B;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="40" y="842" width="270" height="144" as="geometry" />
        </mxCell>
        <mxCell id="pg9-a4n" value="Problem messages are shown beside the fields" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=18;whiteSpace=wrap;html=1;fillColor=#E3EEF9;strokeColor=#2F5597;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="335" y="886" width="240" height="56" as="geometry" />
        </mxCell>
        <mxCell id="pg9-a5" value="The conference and its first edition are created; the definition is kept in this browser" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=18;whiteSpace=wrap;html=1;fillColor=#E3EEF9;strokeColor=#2F5597;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="55" y="1044" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pg9-a6" value="Later: 'Work on it', 'Change' or 'Delete' (delete asks to confirm; built-in conferences cannot be changed)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#2F6B44;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="55" y="1172" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pg9-b1" value="Open 'Editions (years)' and click 'Create a new edition'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#2F6B44;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="615" y="414" width="240" height="56" as="geometry" />
        </mxCell>
        <mxCell id="pg9-b2" value="Choose the conference, type the year and choose the edition to copy the set-up from" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#2F6B44;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="615" y="536" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pg9-b3" value="Is the year valid and unused for this conference?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#B8860B;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="600" y="672" width="270" height="112" as="geometry" />
        </mxCell>
        <mxCell id="pg9-b3n" value="Problem message beside the Year box" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=18;whiteSpace=wrap;html=1;fillColor=#E3EEF9;strokeColor=#2F5597;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="895" y="700" width="240" height="56" as="geometry" />
        </mxCell>
        <mxCell id="pg9-b4" value="A new empty draft opens. It copies pages, rooms, topics, email templates and settings, never papers, people, schedule or news" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=18;whiteSpace=wrap;html=1;fillColor=#E3EEF9;strokeColor=#2F5597;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="615" y="863" width="240" height="102" as="geometry" />
        </mxCell>
        <mxCell id="pg9-b5" value="Open 'Edition details': fill in name, place and topics, click the conference days on the calendar and save" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#2F6B44;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="615" y="1044" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pg9-b6" value="Set up Schedule, Pages and menu, Registration form and Site settings for the new year" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#2F6B44;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="615" y="1172" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pg9-c1" value="On the draft edition click 'Preview' (opens the public website as the team)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#2F6B44;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="1175" y="414" width="240" height="56" as="geometry" />
        </mxCell>
        <mxCell id="pg9-c2" value="Click 'Publish'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#2F6B44;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="1175" y="543" width="240" height="56" as="geometry" />
        </mxCell>
        <mxCell id="pg9-c3" value="Has the edition a name and conference days?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#B8860B;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="1160" y="672" width="270" height="112" as="geometry" />
