        </mxCell>
        <mxCell id="pg8-b3" value="The change appears on the public home page and header" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=18;whiteSpace=wrap;html=1;fillColor=#E3EEF9;strokeColor=#2F5597;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="600" y="664" width="240" height="56" as="geometry" />
