          <mxGeometry x="40" y="422" width="240" height="56" as="geometry" />
        </mxCell>
        <mxCell id="pg8-a2" value="Open a page's Settings and tick the roles that may read it (for example Guest)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#2F6B44;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="40" y="536" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pg8-a3" value="Click 'See the public website' and set 'Viewing as' to check the menu" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#2F6B44;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
