        </mxCell>
        <mxCell id="pg5-a2" value="Filter the list; 'See details'; record payment status; edit a person; 'Send confirmation' (only records a line)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#2F6B44;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
