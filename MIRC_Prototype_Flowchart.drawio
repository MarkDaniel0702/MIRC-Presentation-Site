        <mxCell id="pg8-b2" value="Edit the text blocks, news items or header (title, subtitle, date, place, banner line) and save" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#2F6B44;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
