          <mxGeometry x="40" y="1176" width="270" height="98" as="geometry" />
        </mxCell>
        <mxCell id="pg10-a6y" value="The logo is saved and visitors see it at once" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=18;whiteSpace=wrap;html=1;fillColor=#E3EEF9;strokeColor=#2F5597;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="335" y="1197" width="240" height="56" as="geometry" />
        </mxCell>
        <mxCell id="pg10-a7" value="A draft logo is saved: visitors keep the old logo while the team previews the new one" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=18;whiteSpace=wrap;html=1;fillColor=#E3EEF9;strokeColor=#2F5597;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="55" y="1332" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pg10-a8" value="Later: 'Publish this logo now' (asks to confirm) or discard the draft" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#2F6B44;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="55" y="1460" width="240" height="56" as="geometry" />
        </mxCell>
        <mxCell id="pg10-b1" value="Open 'Site colors' and change any of the 8 colors with the picker or by typing a HEX code" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#2F6B44;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="895" y="422" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pg10-b2" value="Is every HEX code valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#B8860B;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="880" y="550" width="270" height="98" as="geometry" />
        </mxCell>
        <mxCell id="pg10-b2n" value="A message says a color code is not valid; nothing is saved" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=18;whiteSpace=wrap;html=1;fillColor=#E3EEF9;strokeColor=#2F5597;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="1203" y="571" width="240" height="56" as="geometry" />
        </mxCell>
        <mxCell id="pg10-b3" value="A live preview and a readability list update at once; hard-to-read pairs are flagged" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=18;whiteSpace=wrap;html=1;fillColor=#E3EEF9;strokeColor=#2F5597;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="895" y="714" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pg10-b4" value="Press 'Save' (a published edition can also 'Save as a draft')" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#2F6B44;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="895" y="871" width="240" height="56" as="geometry" />
        </mxCell>
        <mxCell id="pg10-b5" value="Are some colors hard to read?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#B8860B;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="880" y="1013" width="270" height="98" as="geometry" />
        </mxCell>
        <mxCell id="pg10-b6" value="Save them anyway? (a second confirmation)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#B8860B;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="1286" y="1006" width="270" height="112" as="geometry" />
        </mxCell>
        <mxCell id="pg10-b6n" value="Nothing is saved; go back and change the colors" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=18;whiteSpace=wrap;html=1;fillColor=#E3EEF9;strokeColor=#2F5597;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="1665" y="1034" width="240" height="56" as="geometry" />
        </mxCell>
        <mxCell id="pg10-b7" value="The palette is saved. A draft palette is previewed by the team, then published or discarded" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=18;whiteSpace=wrap;html=1;fillColor=#E3EEF9;strokeColor=#2F5597;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="895" y="1182" width="240" height="86" as="geometry" />
        </mxCell>
        <mxCell id="pg10-b8" value="Later: 'Reset all colors' or 'Earlier palettes' go back (they ask to confirm)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#2F6B44;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
