          <mxGeometry x="40" y="730" width="270" height="98" as="geometry" />
        </mxCell>
        <mxCell id="pg5-a3y" value="A CSV file of the sample data is downloaded" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=18;whiteSpace=wrap;html=1;fillColor=#E3EEF9;strokeColor=#2F5597;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
