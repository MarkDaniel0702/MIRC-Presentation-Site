  <diagram id="pg3" name="3 Register, submit, sign in">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="pg3-title" value="&lt;b style=&quot;font-size:20px&quot;&gt;3. Public website: registration, abstract submission and sign in&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;Reached from page 2 (&amp;quot;Other pages&amp;quot;). Nothing is saved on a server and no email is sent.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="14" width="760" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pg3-s" value="Start: on the public website, open the Menu" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1F3D2B;strokeColor=#1F3D2B;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="903" y="120" width="250" height="54" as="geometry" />
        </mxCell>
        <mxCell id="pg3-dp" value="Which page do you want?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#B8860B;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="893" y="232" width="270" height="98" as="geometry" />
        </mxCell>
        <mxCell id="pg3-a1" value="Is registration open for this edition?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#B8860B;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="333" y="422" width="270" height="98" as="geometry" />
        </mxCell>
        <mxCell id="pg3-a1n" value="Note: registration is not open; the deadline is shown if known" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=18;whiteSpace=wrap;html=1;fillColor=#E3EEF9;strokeColor=#2F5597;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="628" y="443" width="240" height="56" as="geometry" />
        </mxCell>
        <mxCell id="pg3-a2" value="Fill in the form: first name, last name and email are always asked; other details as the team set them" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#2F6B44;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="348" y="631" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pg3-a3" value="Press 'Save my registration'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#2F6B44;strokeWidth=1.5;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="1">
