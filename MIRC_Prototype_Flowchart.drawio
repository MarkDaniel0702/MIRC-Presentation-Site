        <mxCell id="pg2-title" value="&lt;b style=&quot;font-size:20px&quot;&gt;2. Public website preview: browsing, editions and the program&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;What a visitor sees. Start from the Dashboard link &amp;quot;See the public website&amp;quot;. Registration, submission and account pages are on page 3.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="14" width="760" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pg2-s" value="Start: on the Dashboard click 'See the public website'" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1F3D2B;strokeColor=#1F3D2B;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1">
